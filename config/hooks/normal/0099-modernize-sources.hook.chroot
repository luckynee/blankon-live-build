#!/bin/sh

echo "[MODERNIZE SOURCE]"
apt modernize-sources --assume-yes

echo "[REMOVE SOURCE WITH OLD FORMAT]"
rm -f /etc/apt/sources.list.bak
rm -f /etc/apt/sources.list.d/*.bak

echo "I: Removing temporary local package repositories..."
rm -f /etc/apt/sources.list.d/packages.sources
rm -f /etc/apt/sources.list.d/packages.list

echo "[REMOVE DUPLICATION]"
if [ -f /etc/apt/sources.list ]; then
    rm /etc/apt/sources.list
fi
